# Optional: backend is same-origin under /api by default. Only set this to point
# the web app at a different origin (e.g. a separate API deployment).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- server only (never NEXT_PUBLIC) — see README for where each comes from ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
APP_URL=http://localhost:3000
WEBHOOK_SECRET=
CRON_SECRET=
# optional overrides
SUMMARY_MODEL=anthropic/claude-sonnet-5
CHAT_MODEL=anthropic/claude-haiku-4.5
EMBED_MODEL=openai/text-embedding-3-small
